# Server-side session signing key: generate a unique random value of at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Email delivery (Gmail App Password; never commit real values).
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Supabase project. The service-role key is server-only and MUST NOT use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional public anon key only if another browser-side feature explicitly needs it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Required to enable teacher registration; use a unique random value (at least 32 characters).
TEACHER_REGISTRATION_CODE=replace-with-institution-issued-secret
